# Orbit Server Environment Variables Example
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here_min_32_chars
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Frontend Client URL(s) (comma-separated if multiple origins, used for CORS and email links)
CLIENT_URL=http://localhost:3000

# Optional dedicated secret for verification code HMAC hashing (defaults to JWT_SECRET if unset)
EMAIL_VERIFICATION_SECRET=your_email_verification_secret_here

# Reverse Proxy Configuration (set to "true" when behind Nginx, Render, Heroku, Cloudflare, etc.)
TRUST_PROXY=false

# Optional DNS configuration (comma-separated servers, or enable override for Windows SRV workarounds)
# DNS_SERVERS=8.8.8.8,1.1.1.1
# ENABLE_DNS_OVERRIDE=false

# Gmail SMTP Configuration (Nodemailer)
# 1. Enable 2-Step Verification on your personal Google Account:
#    https://myaccount.google.com/security -> 2-Step Verification
# 2. Generate a 16-character App Password under:
#    https://myaccount.google.com/apppasswords
#    - Select app name: "Orbit Chat" (or custom)
#    - Click Generate
# 3. Enter your Gmail address and the 16-character app password (without spaces) below:
GMAIL_USER=your_personal_account@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
GMAIL_SENDER_NAME="Orbit"
