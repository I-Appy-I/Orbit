# Orbit Frontend Environment Variables Example

# Storage key for session data in localStorage
REACT_APP_LOCALHOST_KEY="chat-app-user"

# Backend API base URL (omit in local development to default to http://localhost:5000)
# In production, set to your deployed backend origin (e.g. https://api.orbit-chat.com)
REACT_APP_API_URL="http://localhost:5000"

# Optional separate Socket.IO server URL (defaults to REACT_APP_API_URL)
# REACT_APP_SOCKET_URL="https://api.orbit-chat.com"

# Optional media path overrides (if using an external CDN or object storage)
# Leave blank to automatically derive from backend host
# REACT_APP_PROFILE_PICS_PATHS="http://localhost:5000/images/profile_pictures/"
# REACT_APP_ATTACHMENT_PATHS="http://localhost:5000/api/messages/attachment/"
